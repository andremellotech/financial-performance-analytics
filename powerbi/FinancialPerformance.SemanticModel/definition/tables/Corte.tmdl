table Corte
	column Mes
		dataType: int64
		sourceColumn: Mes
		summarizeBy: none

	column NomeMes
		dataType: string
		sourceColumn: NomeMes
		summarizeBy: none
		sortByColumn: Mes

	partition Corte = m
		mode: import
		source =
			#table(type table [Mes = Int64.Type, NomeMes = text], {{1, "Jan"}, {2, "Fev"}, {3, "Mar"}, {4, "Abr"}, {5, "Mai"}, {6, "Jun"}, {7, "Jul"}, {8, "Ago"}, {9, "Set"}, {10, "Out"}, {11, "Nov"}, {12, "Dez"}})
