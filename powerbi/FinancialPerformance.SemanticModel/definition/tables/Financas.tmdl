table Financas
	measure 'Receita realizada' = CALCULATE(SUM(Financas[Valor]), Financas[Cenario] = "Realizado", Categorias[CategoriaId] = "REV")
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Receita orçada' = CALCULATE(SUM(Financas[Valor]), Financas[Cenario] = "Orçado", Categorias[CategoriaId] = "REV")
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Gastos realizados' = -CALCULATE(SUM(Financas[Valor]), Financas[Cenario] = "Realizado", Categorias[Natureza] = "Despesa")
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Gastos orçados' = -CALCULATE(SUM(Financas[Valor]), Financas[Cenario] = "Orçado", Categorias[Natureza] = "Despesa")
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado realizado' = CALCULATE(SUM(Financas[Valor]), Financas[Cenario] = "Realizado")
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado orçado' = CALCULATE(SUM(Financas[Valor]), Financas[Cenario] = "Orçado")
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Margem realizada' = DIVIDE([Resultado realizado], [Receita realizada])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Margem orçada' = DIVIDE([Resultado orçado], [Receita orçada])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Desvio do resultado' = [Resultado realizado] - [Resultado orçado]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Desvio percentual' = DIVIDE([Desvio do resultado], ABS([Resultado orçado]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Resultado ano anterior' = IF(HASONEVALUE(Calendario[Ano]), CALCULATE([Resultado realizado], DATEADD(Calendario[Data], -1, YEAR)))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Variação anual' = VAR Anterior = [Resultado ano anterior] RETURN IF(NOT ISBLANK(Anterior), DIVIDE([Resultado realizado] - Anterior, ABS(Anterior)))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Mês de referência' = SELECTEDVALUE(Corte[Mes], 9)
		formatString: 0
		displayFolder: Indicadores

	measure 'Receita realizada até corte' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Receita realizada], KEEPFILTERS(Calendario[Mes] <= CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Gastos realizados até corte' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Gastos realizados], KEEPFILTERS(Calendario[Mes] <= CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado realizado até corte' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Resultado realizado], KEEPFILTERS(Calendario[Mes] <= CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Receita orçada restante' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Receita orçada], KEEPFILTERS(Calendario[Mes] > CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Gastos orçados restantes' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Gastos orçados], KEEPFILTERS(Calendario[Mes] > CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado orçado restante' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Resultado orçado], KEEPFILTERS(Calendario[Mes] > CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Receita do mês' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Receita realizada], KEEPFILTERS(Calendario[Mes] = CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Gastos do mês' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Gastos realizados], KEEPFILTERS(Calendario[Mes] = CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado do mês' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Resultado realizado], KEEPFILTERS(Calendario[Mes] = CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado orçado do mês' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Resultado orçado], KEEPFILTERS(Calendario[Mes] = CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado orçado até corte' = VAR CorteMes = [Mês de referência] RETURN IF(HASONEVALUE(Calendario[Ano]), COALESCE(CALCULATE([Resultado orçado], KEEPFILTERS(Calendario[Mes] <= CorteMes)), 0))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Receita EAC' = [Receita realizada até corte] + [Receita orçada restante]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Gastos EAC' = [Gastos realizados até corte] + [Gastos orçados restantes]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Resultado EAC' = [Resultado realizado até corte] + [Resultado orçado restante]
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Margem EAC' = DIVIDE([Resultado EAC], [Receita EAC])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Desvio EAC' = IF(NOT ISBLANK([Resultado EAC]), [Resultado EAC] - [Resultado orçado])
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Desvio EAC percentual' = DIVIDE([Desvio EAC], ABS([Resultado orçado]))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Desvio de gastos EAC' = IF(NOT ISBLANK([Gastos EAC]), [Gastos orçados] - [Gastos EAC])
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Impacto da receita EAC' = IF(NOT ISBLANK([Receita EAC]), [Receita EAC] - [Receita orçada])
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Economias de gastos' = IF(HASONEVALUE(Calendario[Ano]), SUMX(FILTER(VALUES(Categorias[CategoriaId]), Categorias[CategoriaId] <> "REV"), MAX([Desvio de gastos EAC], 0)))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Aumentos de gastos' = IF(HASONEVALUE(Calendario[Ano]), SUMX(FILTER(VALUES(Categorias[CategoriaId]), Categorias[CategoriaId] <> "REV"), MAX(-[Desvio de gastos EAC], 0)))
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	measure 'Margem do mês' = DIVIDE([Resultado do mês], [Receita do mês])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Indicadores

	measure 'Desvio do mês' = IF(NOT ISBLANK([Resultado do mês]), [Resultado do mês] - [Resultado orçado do mês])
		formatString: "R$" #,0.00;-"R$" #,0.00;"R$" 0.00
		displayFolder: Indicadores

	column Data
		dataType: dateTime
		sourceColumn: Data
		summarizeBy: none
		formatString: dd/MM/yyyy

	column AreaId
		dataType: string
		sourceColumn: AreaId
		summarizeBy: none

	column CategoriaId
		dataType: string
		sourceColumn: CategoriaId
		summarizeBy: none

	column Cenario
		dataType: string
		sourceColumn: Cenario
		summarizeBy: none

	column Valor
		dataType: decimal
		sourceColumn: Valor
		summarizeBy: sum

	partition Financas = m
		mode: import
		source =
			let
			    BinarySource = if Text.Length(pDataFolder) = 0 then Binary.FromText("", BinaryEncoding.Base64)
			        else File.Contents(Text.TrimEnd(pDataFolder, {"/", "\"}) & "/fact_finance.csv"),
			    Raw = Csv.Document(BinarySource, [Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"month", type date}, {"area_id", type text}, {"category_id", type text}, {"scenario", type text}, {"amount_brl", Currency.Type}}, "en-US"),
			    Keys = {"month", "area_id", "category_id", "scenario"},
			    ValidRows = List.AllTrue(List.Transform(Table.ToRecords(Typed), each
			        Date.Day([month]) = 1 and List.Contains({2024, 2025}, Date.Year([month])) and
			        List.Contains({"ANA", "ENG", "OPS"}, [area_id]) and
			        List.Contains({"REV", "DIR", "PES", "TEC", "COM", "ADM"}, [category_id]) and
			        List.Contains({"Orçado", "Realizado"}, [scenario]) and
			        [amount_brl] <> null and Number.Round([amount_brl], 2) = [amount_brl] and
			        (if [category_id] = "REV" then [amount_brl] >= 0 else [amount_brl] <= 0))),
			    Checked = if Table.RowCount(Typed) = 864 and Table.RowCount(Table.Distinct(Typed, Keys)) = 864 and ValidRows
			        then Typed else error "Base inválida: confira cobertura, chaves, cenários e sinais.",
			    Renamed = Table.RenameColumns(Checked, {{"month", "Data"}, {"area_id", "AreaId"}, {"category_id", "CategoriaId"}, {"scenario", "Cenario"}, {"amount_brl", "Valor"}})
			in
			    Renamed
