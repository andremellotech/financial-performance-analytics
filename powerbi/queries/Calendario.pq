let
    BinarySource = if Text.Length(pDataFolder) = 0 then Binary.FromText("", BinaryEncoding.Base64)
        else File.Contents(Text.TrimEnd(pDataFolder, {"/", "\"}) & "/dim_calendar.csv"),
    Raw = Csv.Document(BinarySource, [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),
    Typed = Table.TransformColumnTypes(Headers, {{"date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"year_month_order", Int64.Type}}, "en-US"),
    ExpectedRaw = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
    ExpectedTyped = Table.TransformColumnTypes(Table.PromoteHeaders(ExpectedRaw, [PromoteAllScalars=true]), {{"date", type date}, {"year", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"year_month_order", Int64.Type}}, "en-US"),
    MatchingRows = List.Count(List.Intersect({Table.ToRows(Typed), Table.ToRows(ExpectedTyped)})),
    Checked = if Table.RowCount(Typed) = 731 and Table.RowCount(Table.Distinct(Typed)) = 731 and MatchingRows = 731
        then Typed else error "Dimensão inválida: confira cobertura, chaves, rótulos e atributos.",
    Renamed = Table.RenameColumns(Checked, {{"date", "Data"}, {"year", "Ano"}, {"month", "Mes"}, {"month_name", "NomeMes"}, {"year_month", "AnoMes"}, {"year_month_order", "OrdemAnoMes"}})
in
    Renamed
